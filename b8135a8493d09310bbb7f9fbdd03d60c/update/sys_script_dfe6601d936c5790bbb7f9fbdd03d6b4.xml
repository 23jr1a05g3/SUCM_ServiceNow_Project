        <script><![CDATA[(function executeRule(current, previous) {
  var issueId = current.getValue('civic_issue');
  if (!issueId) return;
  var s = current.getValue('status');

  var p = new GlideRecord('x_2258429_smart_0_civic_issue');
  if (p.get(issueId)) {
    p.status = s;
    p.update();
  }

  var kids = new GlideRecord('x_2258429_smart_0_civic_issue');
  kids.addQuery('parent_issue', issueId);
  kids.query();
  while (kids.next()) {
    kids.status = s;
    kids.update();
  }
})(current, previous);]]></script>
